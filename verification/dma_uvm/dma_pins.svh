class dma_frame extends uvm_sequence_item;
  `uvm_object_utils(dma_frame)
  logic  reset_n;
  logic [31:0] c_awaddr;
  logic  c_awvalid;
  logic  c_awready;
  logic [31:0] c_wdata;
  logic [3:0] c_wstrb;
  logic  c_wvalid;
  logic  c_wready;
  logic [1:0] c_bresp;
  logic  c_bvalid;
  logic  c_bready;
  logic [31:0] c_araddr;
  logic  c_arvalid;
  logic  c_arready;
  logic [31:0] c_rdata;
  logic [1:0] c_rresp;
  logic  c_rvalid;
  logic  c_rready;
  logic  irq;
  logic [3:0] d_awid;
  logic [31:0] d_awaddr;
  logic [7:0] d_awlen;
  logic [2:0] d_awsize;
  logic [1:0] d_awburst;
  logic  d_awvalid;
  logic  d_awready;
  logic [63:0] d_wdata;
  logic [7:0] d_wstrb;
  logic  d_wlast;
  logic  d_wvalid;
  logic  d_wready;
  logic [3:0] d_bid;
  logic [1:0] d_bresp;
  logic  d_bvalid;
  logic  d_bready;
  logic [3:0] d_arid;
  logic [31:0] d_araddr;
  logic [7:0] d_arlen;
  logic [2:0] d_arsize;
  logic [1:0] d_arburst;
  logic  d_arvalid;
  logic  d_arready;
  logic [3:0] d_rid;
  logic [63:0] d_rdata;
  logic [1:0] d_rresp;
  logic  d_rlast;
  logic  d_rvalid;
  logic  d_rready;
  function new(string n="dma_frame");super.new(n);endfunction
endclass
class dma_monitor extends uvm_component;
  `uvm_component_utils(dma_monitor)
  dma_config cfg; uvm_analysis_port#(dma_frame) observed;
  function new(string n,uvm_component p);super.new(n,p);observed=new("observed",this);endfunction
  task run_phase(uvm_phase phase);dma_frame f;forever begin @(cfg.vif.sample);f=dma_frame::type_id::create("pins");
    f.reset_n=cfg.vif.sample.reset_n;
    f.c_awaddr=cfg.vif.sample.c_awaddr;
    f.c_awvalid=cfg.vif.sample.c_awvalid;
    f.c_awready=cfg.vif.sample.c_awready;
    f.c_wdata=cfg.vif.sample.c_wdata;
    f.c_wstrb=cfg.vif.sample.c_wstrb;
    f.c_wvalid=cfg.vif.sample.c_wvalid;
    f.c_wready=cfg.vif.sample.c_wready;
    f.c_bresp=cfg.vif.sample.c_bresp;
    f.c_bvalid=cfg.vif.sample.c_bvalid;
    f.c_bready=cfg.vif.sample.c_bready;
    f.c_araddr=cfg.vif.sample.c_araddr;
    f.c_arvalid=cfg.vif.sample.c_arvalid;
    f.c_arready=cfg.vif.sample.c_arready;
    f.c_rdata=cfg.vif.sample.c_rdata;
    f.c_rresp=cfg.vif.sample.c_rresp;
    f.c_rvalid=cfg.vif.sample.c_rvalid;
    f.c_rready=cfg.vif.sample.c_rready;
    f.irq=cfg.vif.sample.irq;
    f.d_awid=cfg.vif.sample.d_awid;
    f.d_awaddr=cfg.vif.sample.d_awaddr;
    f.d_awlen=cfg.vif.sample.d_awlen;
    f.d_awsize=cfg.vif.sample.d_awsize;
    f.d_awburst=cfg.vif.sample.d_awburst;
    f.d_awvalid=cfg.vif.sample.d_awvalid;
    f.d_awready=cfg.vif.sample.d_awready;
    f.d_wdata=cfg.vif.sample.d_wdata;
    f.d_wstrb=cfg.vif.sample.d_wstrb;
    f.d_wlast=cfg.vif.sample.d_wlast;
    f.d_wvalid=cfg.vif.sample.d_wvalid;
    f.d_wready=cfg.vif.sample.d_wready;
    f.d_bid=cfg.vif.sample.d_bid;
    f.d_bresp=cfg.vif.sample.d_bresp;
    f.d_bvalid=cfg.vif.sample.d_bvalid;
    f.d_bready=cfg.vif.sample.d_bready;
    f.d_arid=cfg.vif.sample.d_arid;
    f.d_araddr=cfg.vif.sample.d_araddr;
    f.d_arlen=cfg.vif.sample.d_arlen;
    f.d_arsize=cfg.vif.sample.d_arsize;
    f.d_arburst=cfg.vif.sample.d_arburst;
    f.d_arvalid=cfg.vif.sample.d_arvalid;
    f.d_arready=cfg.vif.sample.d_arready;
    f.d_rid=cfg.vif.sample.d_rid;
    f.d_rdata=cfg.vif.sample.d_rdata;
    f.d_rresp=cfg.vif.sample.d_rresp;
    f.d_rlast=cfg.vif.sample.d_rlast;
    f.d_rvalid=cfg.vif.sample.d_rvalid;
    f.d_rready=cfg.vif.sample.d_rready;
    observed.write(f);end endtask
endclass
